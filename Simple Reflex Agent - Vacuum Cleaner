# Practical 1: Simple Reflex Agent - Vacuum Cleaner World (2 rooms: A and B)

def reflex_vacuum_agent(percept):
    location, status = percept
    if status == "Dirty":
        return "Suck"
    elif location == "A":
        return "Right"
    else:
        return "Left"

def run_vacuum(env, location, steps=6):
    score = 0
    print("Start:", env, "| Agent in room", location)
    print(f"{'Step':<6}{'Percept':<20}{'Action':<8}{'Score'}")
    for t in range(1, steps + 1):
        percept = (location, env[location])
        action = reflex_vacuum_agent(percept)
        if action == "Suck":
            env[location] = "Clean"
            score += 10          # +10 for cleaning
        elif action == "Right":
            location = "B"
            score -= 1           # -1 for every move
        else:
            location = "A"
            score -= 1
        print(f"{t:<6}{str(percept):<20}{action:<8}{score}")
    print("Final environment:", env, "| Final score:", score)

run_vacuum({"A": "Dirty", "B": "Dirty"}, "A")
print()
run_vacuum({"A": "Clean", "B": "Dirty"}, "A")
